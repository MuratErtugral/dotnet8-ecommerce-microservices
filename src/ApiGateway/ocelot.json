{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/v1/campaigns/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        { "Host": "engagement-api", "Port": 8080 }
      ],
      "UpstreamPathTemplate": "/gateway/campaigns/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "RateLimitOptions": {
        "ClientWhitelist": [],
        "EnableRateLimiting": true,
        "Period": "1s",
        "PeriodTimespan": 1,
        "Limit": 50
      }
    },
    {
      "DownstreamPathTemplate": "/api/v1/recommendations/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        { "Host": "engagement-api", "Port": 8080 }
      ],
      "UpstreamPathTemplate": "/gateway/recommendations/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST" ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5000"
  }
}
